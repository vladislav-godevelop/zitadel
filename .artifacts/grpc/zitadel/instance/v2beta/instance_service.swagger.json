        "summary": "List Instances",
        "description": "Deprecated: please move to the corresponding endpoint under instance service v2. This endpoint will be removed with the next major version of ZITADEL.\n\nLists instances matching the given query.\nThe query can be used to filter either by instance ID or domain.\nThe request is paginated and returns 100 results by default.\n\nRequired permissions:\n - `system.instance.read`",
        "operationId": "InstanceService_ListInstances",
        "responses": {
          "200": {
            "description": "The list of instances.",
            "schema": {
              "$ref": "#/definitions/v2betaListInstancesResponse"
            }
          },
          "403": {
            "description": "Returned when the user does not have permission to access the resource.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          },
          "404": {
            "description": "Returned when the resource does not exist.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/v2betaListInstancesRequest"
            }
          }
        ],
        "tags": [
          "InstanceService"
        ],
        "deprecated": true
      }
    },
